# Copy to .env on the server, fill in the database lines, then run: php artisan key:generate
# Live site: APP_ENV=production and APP_DEBUG=false (never show error details to visitors).
APP_NAME="Unlock-SD"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://unlock.sunxfinder.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL / MariaDB. Every table name starts with tbl_ (the app expects this prefix).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=tbl_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin > Server Tools (all optional)
SERVER_TOOLS_ENABLED=true
# PHP command-line program for composer.phar; empty = found automatically (cPanel: /opt/cpanel/ea-php82/root/usr/bin/php)
SERVER_TOOLS_PHP=
# Only when the site is served from another folder than public/ (e.g. /home/USER/public_html); empty = "Copy public folders" is off
SERVER_TOOLS_COPY_TO=
SERVER_TOOLS_COPY_FOLDERS=assets,uploads
SERVER_TOOLS_LOG_LINES=300
